# Generated by `jaato-scaffold new`.  Active settings below;
# commented lines are optional knobs the daemon/plugins read
# (see `jaato-scaffold explain env`).

# daemon socket — unset means the SDK's default, which is what a stock
# jaato-server listens on.  Set it only if yours listens elsewhere.
# JAATO_IPC_SOCKET=/tmp/jaato.sock

# select this profile-set at runtime (tier-2 overlay)
JAATO_PROFILE_SET=openrouter_gpt_audio_mini

# provider credential — fill in (openrouter); referenced by
# the set profiles as ${JAATO_OPENROUTER_API_KEY}.
# Supplied by the profile's env: block as pass://jaato/openrouter/api-key,
# resolved daemon-side.  Left unset here on purpose: an empty
# assignment is a blank VALUE, not an absent one.
# JAATO_OPENROUTER_API_KEY=

# ---- provider: openrouter (uncomment + set as needed) ----
# JAATO_OPENROUTER_APP_CATEGORIES=
# JAATO_OPENROUTER_APP_TITLE=
# JAATO_OPENROUTER_BASE_URL=
# JAATO_OPENROUTER_CONTEXT_LENGTH=
# JAATO_OPENROUTER_HTTP_REFERER=
# JAATO_OPENROUTER_MODEL=

# ---- daemon knobs (defaults shown) ----
# JAATO_EPHEMERAL_TIMEOUT_S=1800
# JAATO_RUNNER_POOL_SIZE=2
# MODEL_NAME=gemini-2.5-flash

# ---- framework knobs (defaults shown) ----
# JAATO_DEFERRED_TOOLS=true
# JAATO_PARALLEL_TOOLS=true

# ---- plugin:environment knobs (defaults shown) ----
# SHELL=/bin/sh

# ---- plugin:gc knobs (defaults shown) ----
# JAATO_GC_PRESSURE=90.0
# JAATO_GC_TARGET=60.0
# JAATO_GC_THRESHOLD=80.0

# ---- plugin:mermaid_formatter knobs (defaults shown) ----
# JAATO_KROKI_URL=https://kroki.io

# ---- plugin:notebook knobs (defaults shown) ----
# JAATO_TOOL_BINDINGS=true

# ---- plugin:table_formatter knobs (defaults shown) ----
# JAATO_AMBIGUOUS_WIDTH=1

# ---- plugin:todo knobs (defaults shown) ----
# TODO_STORAGE_PATH=./todo_plans.json

# ---- rate_limit knobs (defaults shown) ----
# AI_REQUEST_INTERVAL=0
# AI_RETRY_ATTEMPTS=5
# AI_RETRY_BASE_DELAY=1.0
# AI_RETRY_MAX_DELAY=30.0

# ---- telemetry knobs (defaults shown) ----
# JAATO_TELEMETRY_EXPORTER=otlp
# JAATO_TELEMETRY_FILE=/tmp/jaato-traces.jsonl
# JAATO_TELEMETRY_REDACT_CONTENT=true
# OTEL_SERVICE_NAME=jaato
